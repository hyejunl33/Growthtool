# Optional: production integrations. The MVP runs locally with a demo trend feed.
OPENAI_API_KEY=
PHOTOROOM_API_KEY=

# Supabase Auth, PostgreSQL and private Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Naver Shopping Insight adapter. Never prefix these values with NEXT_PUBLIC_.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SHOPPING_CATEGORY=50000000
NAVER_TREND_CATEGORY_LABEL=패션의류
# The Naver API accepts up to five keyword groups per request.
NAVER_TREND_KEYWORDS_JSON='[{"name":"가을 출근룩","param":["가을 출근룩"],"description":"간절기 출근 코디 탐색 신호"},{"name":"스웨이드 재킷","param":["스웨이드 재킷"],"description":"소재 중심 탐색 신호"}]'

NEXT_PUBLIC_APP_URL=http://localhost:3000
