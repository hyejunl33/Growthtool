# Growth tool runs without fake data. Missing credentials appear as "연결 필요".
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth, PostgreSQL and private Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Actual AI copy and product-image editing
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
PHOTOROOM_API_KEY=

# Beauty trends: Naver Shopping Insight (화장품/미용 category)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SHOPPING_CATEGORY=50000002
NAVER_TREND_CATEGORY_LABEL=화장품/미용
NAVER_TREND_KEYWORDS_JSON='[{"name":"수분 세럼","param":["수분 세럼","히알루론산 세럼"],"description":"수분 세럼 탐색 신호"},{"name":"장벽 크림","param":["장벽 크림","피부 장벽 크림"],"description":"피부 장벽 케어 탐색 신호"},{"name":"톤업 선크림","param":["톤업 선크림"],"description":"선케어·베이스 교차 탐색 신호"}]'

# X regional Trends API. 23424868 is the configurable Korea WOEID default.
X_BEARER_TOKEN=
X_TRENDS_WOEID=23424868

# TikTok has no documented public Creative Center Trends API. Connect a licensed
# provider/proxy that returns {data:[{keyword,score,growth,values,description,observedAt}]}.
TIKTOK_TRENDS_API_URL=
TIKTOK_TRENDS_API_TOKEN=

# Meta Marketing API Insights (read-only token/account)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0
META_CURRENCY=KRW

# TikTok Marketing API integrated reporting
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_ADS_CURRENCY=KRW

# Google Ads REST reporting
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Moloco Analytics API (create a read-only API key in Moloco Ads Manager)
MOLOCO_API_KEY=
MOLOCO_AD_ACCOUNT_ID=
MOLOCO_TIMEZONE=Asia/Seoul
MOLOCO_CURRENCY=KRW
